pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials-id'
        // עדכון השם ל-Repository האמיתי שלך ב-Docker Hub
        DOCKER_IMAGE = 'eliavamir/devops-home-task'
        APP_SERVER_IP = 'APP_SERVER_IP_PLACEHOLDER' // יעודכן לפי הפלט של Terraform
        SSH_CREDENTIALS = 'app-server-ssh-key'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint Check') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r app/requirements.txt
                    flake8 app/
                '''
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh '''
                    . venv/bin/activate
                    pytest app/
                '''
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    // בניית אימג' הדוקר מתוך תיקיית השורש, תוך התאמה לנתיב ה-Dockerfile (אם הוא בתיקיית app או בשורש)
                    // אם ה-Dockerfile בתיקיית השורש, השאר '.', אם הוא בתוך app שрал -f app/Dockerfile app
                    sh 'docker build -t ${DOCKER_IMAGE}:latest .'
                    
                    // התחברות ודחיפה ל-Docker Hub באמצעות ה-Credentials שהוגדר בג'נקינס
                    withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}", 
                                                      usernameVariable: 'DOCKER_USER', 
                                                      passwordVariable: 'DOCKER_PASS')]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        sh 'docker push ${DOCKER_IMAGE}:latest'
                    }
                }
            }
        }

        stage('Deploy to App Server') {
            steps {
                sshagent([SSH_CREDENTIALS]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${APP_SERVER_IP} '
                            docker pull ${DOCKER_IMAGE}:latest
                            docker stop devops-app || true
                            docker rm devops-app || true
                            docker run -d --name devops-app -p 5000:5000 ${DOCKER_IMAGE}:latest
                        '
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sh """
                    sleep 5
                    curl -f http://${APP_SERVER_IP}:5000/ || exit 1
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment completed successfully!'
        }
        failure {
            echo 'Deployment failed.'
        }
    }
}